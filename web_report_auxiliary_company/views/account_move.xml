<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form.aux.company</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//group[@id='header_right_group']//field[@name='taxable_supply_date_placeholder']"
        position="after"
      >
        <field name="aux_company_id" domain="[('is_aux_company','=', True)]" />
        <field name="report_company_id" invisible="1" />
      </xpath>
    </field>
  </record>
</odoo>
