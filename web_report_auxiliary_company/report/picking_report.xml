<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="report_deliveryslip_title" inherit_id="stock.report_delivery_document">
    <xpath expr="//t[@t-call='web.html_container']" position="before">
      <t t-set="company" t-value="o.report_company_id" />
    </xpath>
  </template>

  <template id="report_picking" inherit_id="stock.report_picking">
    <xpath expr="//t[@t-set='address']" position="before">
      <t t-set="company" t-value="o.report_company_id" />
    </xpath>
  </template>
</odoo>
